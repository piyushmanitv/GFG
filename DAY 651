Lexicographically Smallest Rotation
Difficulty: HardAccuracy: 66.43%Submissions: 8K+Points: 8
Given a string s, find the lexicographically smallest string after rotating the string left any number of times including 0.





class Solution {
  public:
    string lexiString(string &s) {
        string doubled = s + s;
        int n = doubled.size();
        vector<int> f(n, -1);
        int k = 0;
        for (int j = 1; j < n; j++) {
            char sj = doubled[j];
            int i = f[j - k - 1];
            while (i != -1 && sj != doubled[k + i + 1]) {
                if (sj < doubled[k + i + 1]) {
                    k = j - i - 1;
                }
                i = f[i];
            }
            if (sj != doubled[k + i + 1]) {
                if (sj < doubled[k]) {
                    k = j;
                }
                f[j - k] = -1;
            } else {
                f[j - k] = i + 1;
            }
        }
        return doubled.substr(k, s.size());
    }
};

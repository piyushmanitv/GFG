Minimum Absolute Difference In BST
Difficulty: MediumAccuracy: 56.22%Submissions: 40K+Points: 4Average Time: 30m
Given the root of a Binary Search Tree (BST) containing n (n > 1) nodes, find the minimum absolute difference between the values of any two different nodes in the tree.

Return the minimum absolute difference.









/* Binary Tree Node Structure
class Node {
public:
    int data;
    Node *left;
    Node *right;

    Node(int val) {
        data = val;
        left = right = nullptr;
    }
}; 
*/

class Solution {
	public:
	int ans;
	int absDiff(Node *root) {
		ans=1e9;
		int prev=1e7;
		dfs(root,prev);
		return ans;
	}

	void dfs(Node* root,int &prev){
	    if(root==NULL) return;

	    dfs(root->left,prev);
	    ans=min(ans,abs(root->data-prev));
	    prev=root->data;
	    dfs(root->right,prev);
	}
};

Given a positive integer n, consider a 4n * 4n matrix filled with integers from 1 to (4n) * (4n) in row-major order (left to right, top to bottom). Form two coils from the matrix:

The first coil starts from the top-left cell (0, 0) and spirals inward.
The second coil starts from the bottom-right cell (4n - 1, 4n - 1) and spirals inward in the opposite direction.
Return these two coils in the same order.
  
  
  
  
  
  
  class Solution {
	public:
	vector<vector<int>> formCoils(int n) {
		// code here
		int idx = 1;
		int top = 0, bottom = 4*n - 1, left = 0, right = 4*n - 1;
		vector<vector<int>> mat(4*n, vector<int>(4*n, 0));
		vector<int>temp1, temp2;
		for (int i = 0; i<4*n; ++i) {
			for (int j = 0; j<4*n; ++j) {
				mat[i][j] = idx++;
			}
		}

		while (left <= right && top <= bottom) {
			if (top <= bottom) {
				for (int i = top; i <= bottom; ++i) {
					temp1.push_back(mat[i][left]);
				}
				for (int i = bottom; i >= top; --i) {
					temp2.push_back(mat[i][right]);
				}
				right--; left++;
			}
			if (left <= right) {
				for (int i = left; i <= right; ++i) {
					temp1.push_back(mat[bottom][i]);
				}
				for (int i = right; i >= left; --i) {
					temp2.push_back(mat[top][i]);
				}
				bottom--; top++;
			}
			if (top <= bottom) {
				for (int i = bottom; i >= top; --i) {
					temp1.push_back(mat[i][right]);
				}
				for (int i = top; i <= bottom; ++i) {
					temp2.push_back(mat[i][left]);
				}
				right--; left++;
			}
			if (left <= right) {
				for (int i = right; i >= left; --i) {
					temp1.push_back(mat[top][i]);
				}
				for (int i = left; i <= right; ++i) {
					temp2.push_back(mat[bottom][i]);
				}
				bottom--; top++ ;
			}
		}
		return {temp1, temp2};
	}
};

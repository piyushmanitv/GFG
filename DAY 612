Largest Rectangle with Column Swaps
Difficulty: HardAccuracy: 55.77%Submissions: 12K+Points: 8
Given a binary matrix mat[][] of size n × m containing only 0s and 1s, any pair of columns may be swapped any number of times.
Return the maximum area of a rectangle consisting entirely of 1's that can be formed after performing the column swaps.









class Solution {
  public:
    int maxArea(vector<vector<int>>& mat) {
        // code here
        int n = mat.size();
        int m = mat[0].size();
        vector<int> height(m, 0);

        int answer = 0;

        for (int i = 0; i < n; i++) {

            vector<int> count(n + 1, 0);

            for (int j = 0; j < m; j++) {
                if (mat[i][j] == 1) {
                    height[j]++;
                } else {
                    height[j] = 0;
                }

                count[height[j]]++;
            }

            int width = 0;

            for (int h = n; h >= 1; h--) {
                width += count[h];

                answer = max(answer, h * width);
            }
        }

        return answer;
    }
};

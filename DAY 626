Sum of Pairwise ANDs
Difficulty: MediumAccuracy: 50.93%Submissions: 49K+Points: 4
Given an array arr[] of integers, calculate the sum of bitwise AND for all pairs of elements such that the first index is less than the second index.









class Solution {
public:
    long long pairAndSum(vector<int> &arr) {
        vector<long long> v(32,0);
        long long sum = 0;
        int n = arr.size();
        for(int i = n-1;i>=0;i--){
            int a = arr[i];
            int j = 0;
            while(a > 0){
               int r = a%2;
               if(r == 1){
                   sum += ((1<<j)*v[j]);
               }
               v[j] = v[j] + r;
               a = a/2;
               j++;
            }
        }
        return sum;
    }
};

